---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="That page does not exist on the D2Excel demo site.">
  <section class="plain">
    <div class="wrap">
      <h1>That page is not here.</h1>
      <p>The link may be old, or the page may not exist yet. Try the home page or the guides.</p>
      <a class="btn" href="/">Go to the home page</a>
    </div>
  </section>
</Layout>
