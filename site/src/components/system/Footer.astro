---
import { NAV } from '../../config';
---
<footer class="footer seam-top theme-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about stack">
        <a class="nav-brand" href="/" aria-label="D2Excel home"><span class="logo-plate" style="padding:0.5rem 1.1rem"><img src="/logo-tight.png" width="326" height="248" alt="" style="height:3rem;width:auto" /></span></a>
        <p style="max-width:26rem">A marketplace connecting students with college admissions counselors, launching in California.</p>
      </div>
      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/join/">Join the waitlist</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-base">
      <p class="mono">Demo site with placeholder content. Nothing here is final.</p>
      <p class="mono">&copy; 2026 D2Excel</p>
    </div>
  </div>
</footer>
