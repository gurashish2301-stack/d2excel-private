---
import { NAV } from '../config';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-bar">
    <a class="brand" href="/" aria-label="D2Excel home"><Logo /></a>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <i class="nav-pill" aria-hidden="true"></i>
      {NAV.map((n, i) => <a style={`--i:${i}`} href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="nav-join" style={`--i:${NAV.length}`} href="/join/">Join the waitlist</a>
    </nav>
    <div class="header-end">
      <a class="btn sm header-cta" href="/join/">Join the waitlist</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span></button>
    </div>
  </div>
</header>
