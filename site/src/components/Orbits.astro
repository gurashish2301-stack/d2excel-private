---
// Abstract orbit rings: two paths (student, counselor) around a shared core. Decorative only.
// It deliberately does not look like a working matcher (no nodes, no lines between people).
---
<div class="orbits" aria-hidden="true">
  <div class="orbit-wrap o1"><div class="orbit"><div class="spin amb"><div class="pos"><i class="dot amb"></i></div></div></div></div>
  <div class="orbit-wrap o2"><div class="orbit"><div class="spin amb"><div class="pos"><i class="dot amb"></i></div></div></div></div>
  <div class="orbit-wrap o3"><div class="orbit"></div></div>
  <div class="core amb"></div>
</div>
